[Desktop Entry]
Type=Application
Name=GenerativeView
Comment=Browse and search folders of AI-generated images
Exec=generativeview %f
Icon=generativeview
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/jxl;inode/directory;
StartupWMClass=com.jrufer.generativeview
